{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vayuta",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_APP_URL": "https://vayuta.com",
    "ADMIN_EMAIL": "tarunthadani@gmail.com",
    "GOOGLE_CLIENT_ID": "262900362504-kn1dka5varognbjbiig7tut11lbv4slb.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://vayuta.com/api/admin/google/callback",
    "PAYU_ENV": "test",
    "PAYPAL_ENV": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "VAYUTA_DB",
      "database_name": "vayuta-shop",
      "database_id": "4abe79de-0282-40a8-b677-db0fef94b2fd"
    }
  ]
}
